pipeline {
    agent any
    options {
        ansiColor('xterm')
    }

    triggers {
        // Poll every 5 minutes; fires only when develop has new commits
        pollSCM('H/5 * * * *')
    }

    environment {
        MARKETPLACE_GIT_URL = credentials('MARKETPLACE_GIT_URL')
        NGINX_CONFIG_PATH = credentials('NGINX_CONFIG_PATH')
        MARKETPLACE_ENV_FILE = credentials('MARKETPLACE_DEV_ENV_FILE')
    }

    stages {

        stage('Set Display Name') {
            steps {
                script {
                    def userId = currentBuild.getBuildCauses('hudson.model.Cause$UserIdCause')[0]?.userId
                    def fullName = "system"
                    if (userId) {
                        def user = jenkins.model.Jenkins.instance.getUser(userId)
                        fullName = user?.getDisplayName() ?: userId
                    }
                    currentBuild.displayName = "Build #${env.BUILD_NUMBER} on branch 'develop' - trigger by ${fullName}"
                }
            }
        }

        stage('Stop running docker container for compose file') {
            steps {
                script {
                    try {
                        sh '''
                            docker compose -p market-dev down --rmi all -v
                        '''
                    } catch (Exception e) {
                        echo "Error during docker compose down, continuing: ${e}"
                    }
                }
                cleanWs()
            }
        }

        stage('Build and Deploy') {
            steps {
                script {
                    git branch: 'develop', url: env.MARKETPLACE_GIT_URL
                    sh '''
                        ENV_FILE='./marketplace-build/templates/.env'
                        cp "$MARKETPLACE_ENV_FILE" "$ENV_FILE"
                        chmod 600 "$ENV_FILE"
                    '''
                }
            }
        }

        stage('Build skip tests with Maven') {
          steps {
            script {
              def javaHome = tool name: 'JDK-25', type: 'hudson.model.JDK'
              withEnv([
                "JAVA_HOME=${javaHome}",
                "PATH+JAVA=${javaHome}/bin"
              ]) {
                sh '''
                  java -version
                  mvn clean install --file ./marketplace-service/pom.xml -DskipTests=true
                '''
              }
            }
          }
        }

        stage('Build and Deploy Containers') {
            steps {
                script {
                    dir("./marketplace-build/templates/dev") {
                        sh '''
                            export NGINX_CONFIG_PATH=$NGINX_CONFIG_PATH
                            export BUILD_ENV=staging
                            export BUILD_VERSION=1.0.0-SNAPSHOT
                            export STABLE_LOG_PATH=/home/axonivy/marketplace/dev/logs/stable
                            export APP_LOG_PATH=/home/axonivy/marketplace/dev/logs/app
                            docker compose -p market-dev up --build --force-recreate -d

                            # Restart live nginx containers by name prefix across environments.
                            # This avoids relying on template compose files or exact versioned names.
                            prefix="market-dev-nginx-"
                            names=$(docker ps --format '{{.Names}}' | grep -E "^${prefix}" || true)
                            if [ -n "$names" ]; then
                                echo "Restarting nginx container(s) with prefix ${prefix}:"
                                echo "$names"
                                echo "$names" | xargs -r docker restart
                            else
                                echo "No running nginx container found with prefix ${prefix}"
                            fi
                        '''
                    }
                }
            }
        }
    }
}
